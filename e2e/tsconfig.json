/* Type checking for the end-to-end tests (npx tsc -p e2e); Playwright runs them without it */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "preserve",
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
